# Application
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Europe/Kirov
APP_NEW_CARDS_PER_DAY=20
BACKEND_PORT=8000
FRONTEND_PORT=8080

# PostgreSQL for local Docker Compose
POSTGRES_DB=python_recall
POSTGRES_USER=python_recall
POSTGRES_PASSWORD=python_recall
POSTGRES_PORT=5433
DOCKER_SUBNET=172.30.250.0/24

# Used when Backend runs directly on the host.
DATABASE_URL=postgresql+psycopg://python_recall:python_recall@localhost:5433/python_recall

# Optional local AI provider (Core API works when disabled or unavailable)
AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Адрес Ollama для Backend внутри Docker Compose.
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
AI_TIMEOUT_SECONDS=120
AI_KEEP_ALIVE=5m
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_RESPONSE_BYTES=1048576
AI_TEMPERATURE=0
